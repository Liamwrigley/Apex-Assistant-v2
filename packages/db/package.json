    "fix:names": "tsx src/scripts/fixTrackedAccountNames.ts"
  },
  "dependencies": {
    "@apex-assistant/core": "0.1.0",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
