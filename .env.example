DATABASE_URL=postgres://user:password@host:5432/apex_tracker
APEXLEGENDSAPI_KEY=replace-me
APEXLEGENDSAPI_BASE_URL=https://api.mozambiquehe.re
DISCORD_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_GUILD_ID=optional-dev-guild-id
# Public web app URL (Discord /dashboard); defaults to production if unset
# DASHBOARD_URL=https://apex-assistant-v2-web-one.vercel.app
APP_SHARED_SECRET=replace-me
# Optional: server-side fetch base. Vercel sets VERCEL_URL; local dev defaults to http://localhost:3000
# WEB_BASE_URL=https://your-production-domain.com
WORKER_API_PORT=4100
WORKER_BASE_URL=http://localhost:4100
WEB_PORT=3000
DISCORD_BOT_PORT=4300
DISCORD_BOT_BASE_URL=http://localhost:4300
MAX_TRACKED_ACCOUNTS_PER_USER=5
MAX_TRACKED_ACCOUNTS_PER_GUILD=100
INGEST_POLL_MINUTES=5
INGEST_POLL_SECONDS_ONLINE=30
INGEST_CLAIM_LEASE_SECONDS=300
INGEST_WORKER_CONCURRENCY=1
INGEST_IDLE_SLEEP_MS=1500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
DEBUG_LOGS=false
ADMIN_UI_KEY=replace-me-long-random-string
# Segment detection: duration (seconds) above which a segment is flagged as possible merge
SEGMENT_MERGE_RISK_THRESHOLD_SEC=1800
